---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="tags">
  {tags.map((tag) => (
    <a href={`/tags/${tag}`} class="tag">#{tag}</a>
  ))}
</div>

<style>
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }

  .tag:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>
