---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="tags">
  {tags.map((tag) => (
    <a href={`/tags/${tag}`} class="tag">#{tag}</a>
  ))}
</div>

<style>
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    transition: background 0.15s, color 0.15s;
  }

  .tag:hover {
    background: #d8daf7;
    color: #4343c7;
    text-decoration: none;
  }
</style>
